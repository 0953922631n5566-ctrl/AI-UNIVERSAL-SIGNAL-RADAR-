{
  "name": "ai-universal-signal-radar-main-market",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "postinstall": "npm test && node --check server.js && node --check src/twelve-data.js && node --check src/trend-rider.js && node --check src/twelve-data-pool.js && node --check src/stream-retry.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "radarArchitecture": {
    "name": "Engine 3 Trend Rider · Twelve Data Native Indicators",
    "displayName": "Single Engine 3 · EMA5 / EMA20 / ATR14",
    "engineCount": 1,
    "deploymentModel": "SINGLE_RENDER_SERVICE",
    "executionModel": "OUR_TREND_RIDER_FORMULA_USING_TWELVE_DATA_NATIVE_INDICATORS",
    "decisionAuthority": "ENGINE_3_ONLY",
    "indicators": {
      "provider": "Twelve Data native endpoints",
      "emaFast": {
        "endpoint": "/ema",
        "period": 5
      },
      "emaTrend": {
        "endpoint": "/ema",
        "period": 20
      },
      "atr": {
        "endpoint": "/atr",
        "period": 14
      },
      "localTechnicalIndicatorCalculations": false,
      "refreshSeconds": 60,
      "estimatedCreditsPerDay": 4320
    },
    "strategy": {
      "name": "TWELVE_DATA_EMA5_EMA20_ATR14_STRUCTURE_CONTINUATION",
      "scoreThreshold": 58,
      "minimumClosedCandles": 30,
      "guards": [
        "SIDEWAYS",
        "LATE_EXTENSION_1_5_ATR",
        "ABNORMAL_RANGE_2_8_ATR"
      ],
      "scoreLeadThreshold": 8,
      "sidewaysGapAtrThreshold": 0.08
    },
    "keyPool": {
      "configuredKeys": 10,
      "rotation": "ROUND_ROBIN_WITH_FAILOVER"
    },
    "manualLightSwitch": {
      "enabled": true,
      "colors": [
        "RED",
        "GREEN"
      ],
      "independentFromRealSignal": true
    },
    "signalHoldSeconds": 30,
    "manualOnly": true,
    "brokerExecution": false
  }
}
