{
  "name": "ai-universal-signal-radar-main-market",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "postinstall": "npm test && node --check server.js && node --check src/twelve-data.js && node --check src/trend-rider.js && node --check src/twelve-data-pool.js && node --check src/stream-retry.js && node --check src/gemini-analyzer.js && node --check src/next-candle-timing.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "radarArchitecture": {
    "name": "Gemini Primary Adaptive Next M1 · Twelve Data OHLC",
    "displayName": "Gemini Primary · Adaptive Next M1",
    "engineCount": 1,
    "deploymentModel": "SINGLE_RENDER_SERVICE",
    "executionModel": "GEMINI_PRIMARY_ADAPTIVE_NEXT_M1_WITH_LOCAL_OHLC",
    "decisionAuthority": "GEMINI_PRIMARY_ONLY",
    "indicators": {
      "provider": "Twelve Data M1 OHLC + Streaming; Gemini Flash for direction",
      "emaFast": {
        "endpoint": "/ema",
        "period": 5
      },
      "emaTrend": {
        "endpoint": "/ema",
        "period": 20
      },
      "atr": {
        "endpoint": "/atr",
        "period": 14
      },
      "localTechnicalIndicatorCalculations": true,
      "refreshSeconds": 0,
      "estimatedCreditsPerDay": 0
    },
    "strategy": {
      "name": "GEMINI_PRIMARY_ADAPTIVE_NEXT_M1",
      "minimumClosedCandles": 54,
      "scoreBasedFiltering": false,
      "entryRule": "Gemini analyzes 54 closed M1 candles plus current live candle before next M1 opens",
      "guards": [
        "SIDEWAYS_GAP_LT_0_05_ATR",
        "LATE_EXTENSION_GT_1_5_ATR",
        "ABNORMAL_RANGE_GT_2_8_ATR",
        "LIVE_TICK_MAX_5_SECONDS"
      ]
    },
    "keyPool": {
      "configuredKeys": 10,
      "rotation": "ROUND_ROBIN_WITH_FAILOVER"
    },
    "manualLightSwitch": {
      "enabled": true,
      "colors": [
        "RED",
        "GREEN"
      ],
      "independentFromRealSignal": true
    },
    "signalHoldSeconds": 30,
    "manualOnly": true,
    "brokerExecution": false
  }
}
