{
  "name": "ai-universal-signal-radar-main-market",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "postinstall": "npm test && node --check server.js && node --check src/twelve-data.js && node --check src/twelve-data-pool.js && node --check src/stream-retry.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "radarArchitecture": {
    "name": "Twelve Data Feed Only · Signal Engine Disabled",
    "displayName": "Market Data Only · No Analyzer",
    "engineCount": 0,
    "deploymentModel": "SINGLE_RENDER_SERVICE",
    "executionModel": "TWELVE_DATA_OHLC_AND_STREAMING_ONLY",
    "decisionAuthority": "NONE",
    "indicators": {
      "provider": "Twelve Data OHLC + Streaming for display only",
      "localTechnicalIndicatorCalculations": false,
      "refreshSeconds": 0,
      "estimatedCreditsPerDay": 0
    },
    "strategy": {
      "name": "NO_SIGNAL_ANALYZER",
      "signalGeneration": false,
      "entryRule": "No directional analysis or CALL/PUT generation"
    },
    "keyPool": {
      "configuredKeys": 10,
      "rotation": "ROUND_ROBIN_WITH_FAILOVER"
    },
    "manualLightSwitch": {
      "enabled": true,
      "colors": [
        "RED",
        "GREEN"
      ],
      "independentFromRealSignal": true
    },
    "manualOnly": true,
    "brokerExecution": false
  }
}
