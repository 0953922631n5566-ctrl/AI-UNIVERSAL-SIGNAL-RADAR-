# Configure secrets only in the Render service Environment page. Never commit real keys.
# Preferred 10-key pool: JSON array string, e.g. ["key-1","key-2"] (use real values only in Render).
TWELVE_DATA_API_KEYS=
# Alternative: TWELVE_DATA_API_KEY_1 through TWELVE_DATA_API_KEY_10.
# Single-key fallback:
TWELVE_DATA_API_KEY=
PORT=3000

# Existing Telegram bot token used to verify Telegram Mini App initData.
TELEGRAM_BOT_TOKEN=
# Optional comma-separated Telegram user IDs. Empty allows any valid Telegram account.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# Android credential is independent of Telegram Mini App auth.
ANDROID_CLIENT_TOKEN=
