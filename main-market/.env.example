# Configure these as private Render Environment Variables in production.
TWELVE_DATA_API_KEY=
PORT=3000

# Generate a 64-character random hex credential; keep it only in Render secrets and Android Keystore.
ANDROID_CLIENT_TOKEN=

# Set the existing Telegram bot token in Render only; never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
